{
  app: {
    products: [
      {
        name: 'default',
        targetSdkVersion: '26.0.1',
        compatibleSdkVersion: '6.1.1(24)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'styleophm',
      srcPath: './styleophm',
      targets: [
        {
          name: 'default',
        },
      ],
    },
  ],
}
